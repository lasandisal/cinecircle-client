# Backend API Base URL (local Vite). Production talks to same-origin /api,
# which Vercel rewrites to the API so the session cookie is first-party.
VITE_API_BASE_URL=http://localhost:5000/api

# Real-time Socket Server URL
VITE_SOCKET_URL=http://localhost:5000

# Session authentication uses an HttpOnly cookie set by the API.
# No Supabase keys belong in the frontend: image uploads go through
# POST /api/users/avatar, which validates the file and stores it server-side.
